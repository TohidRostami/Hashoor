ظ# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development: a plain SQLite file, zero setup.
DATABASE_URL="file:./prisma/dev.db"
#
# Production (Vercel): point these at a Turso database instead — see
# README.md → "دیتابیس روی Vercel (Turso)". Prisma talks to Turso through
# @prisma/adapter-libsql using the two variables below; DATABASE_URL above
# is not used in that code path but Prisma still requires it to be set.
# TURSO_DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# TURSO_AUTH_TOKEN=""

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# SMS OTP provider — the sendOTP() call in lib/auth.ts is provider-agnostic.
# Fill in whichever service you choose (Kavenegar / Ghasedak / SMS.ir / ...);
# until these are set, OTP codes are only logged to the server console.
# ---------------------------------------------------------------------------
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SENDER=""

# ---------------------------------------------------------------------------
# Payment gateway — filled in once you connect the real gateway.
# See lib/payment/README.md for the exact integration seam.
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_MERCHANT_ID=""
PAYMENT_GATEWAY_API_KEY=""

# ---------------------------------------------------------------------------
# ArvanCloud Object Storage (images) — S3-compatible.
# Setup: docs.arvancloud.ir → Object Storage → create a bucket, then
# generate an access key from the dashboard. Full steps in README.md →
# "اتصال Object Storage آروان‌کلاد".
# ---------------------------------------------------------------------------
ARVAN_ENDPOINT="https://s3.ir-thr-at1.arvanstorage.ir"
ARVAN_BUCKET=""
ARVAN_ACCESS_KEY=""
ARVAN_SECRET_KEY=""
# Optional — only needed if you put a custom domain/CDN in front of the
# bucket. Otherwise the public URL is derived automatically from the
# bucket name + endpoint above.
ARVAN_PUBLIC_URL_BASE=""

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
